{
  "defaults": {
    "standard": "WCAG2AA",
    "runners": ["axe"],
    "timeout": 30000,
    "wait": 500,
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-setuid-sandbox"]
    },
    "ignore": [
      "notice",
      "warning"
    ]
  },
  "sitemap": "http://localhost:4000/sitemap.xml",
  "sitemapExclude": [
    "*.xml"
  ]
}

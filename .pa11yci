{
  "defaults": {
    "standard": "WCAG2AA",
    "runners": ["axe"],
    "levelCapWhenNeedsReview": "warning",
    "timeout": 30000,
    "wait": 500,
    "chromeLaunchConfig": {
      "args": ["--no-sandbox", "--disable-setuid-sandbox"]
    },
    "ignore": [
      "notice",
      "warning"
    ]
  }
}
